{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["node", "vitest/globals"],
    "noEmit": true
  },
  "include": [
    "config/**/*.ts",
    "packages/**/*.ts",
    "services/**/*.ts",
    "scripts/**/*.mjs",
    "packages/local-runtime/**/*.ts",
    "tests/bootstrap/**/*.ts",
    "tests/foundation/**/*.ts",
    "tests/integration/**/*.ts",
    "tests/local-tool/**/*.ts",
    "tests/services/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": ["node_modules", "dist", "coverage"]
}
