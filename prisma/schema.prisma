generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model LocalRecord {
  projectId      String
  id             String
  ownerServiceId String
  entityType     String
  label          String
  status         String
  payload        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@id([projectId, id])
  @@index([projectId, ownerServiceId])
  @@index([projectId, entityType])
}

model LocalMedia {
  projectId      String
  id             String
  ownerServiceId String
  fileName       String
  relativePath   String
  contentType    String
  byteSize       Int
  sha256         String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@id([projectId, id])
  @@unique([projectId, relativePath])
  @@index([projectId, ownerServiceId])
}

model LocalOperation {
  projectId   String
  id          String
  title       String
  ok          Boolean
  message     String
  code        String?
  category    String?
  payload     String
  createdAt   DateTime @default(now())

  @@id([projectId, id])
  @@index([projectId, createdAt])
}

model LocalConfig {
  projectId  String
  key       String
  value     String
  updatedAt DateTime @updatedAt

  @@id([projectId, key])
}
